{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "kimi",
  "description": "The Kimi Code web UI served on loopback: only the minimal bridge.",
  "windows": ["host-*"],
  "local": false,
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-kd-set-theme",
    "allow-kd-show-window",
    "allow-kd-notify",
    "allow-kd-retry"
  ]
}
